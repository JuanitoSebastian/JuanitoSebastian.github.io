---
import Html from '../layouts/Html.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import AboutMe from '../components/home/AboutMe.astro';
import ContentContainer from '../components/home/ContentContainer.astro';
import HowIWork from '../components/home/HowIWork.astro';
import Backdrop from '../components/Backdrop.astro';

import juanitoImage from '../images/juanito_polaroid.webp';
import junitoOgImage from '../images/juanito_og_image.webp';

const htmlProps = {
  title: 'Juan Sebastian Covarrubias',
  meta: {
    description:
      'Juan is a web developer and a former technical event production pro.',
    keywords: [
      'react',
      'javascript',
      'typescript',
      'software engineer',
      'web developer',
      'front-end developer',
      'full-stack developer',
    ],
    imageUrl: junitoOgImage.src,
  },
  preload: [juanitoImage.src],
};
---

<style lang="scss">
  .how-i-work-section {
    width: 100%;
  }
</style>

<Html {...htmlProps}>
  <Layout>
    <Hero />
    <ContentContainer borderTop={true}>
      <AboutMe />
    </ContentContainer>
    <div class="how-i-work-section">
      <Backdrop
        background="var(--backdrop-gradient)"
        text="So, how do I do things?"
        headingLevel="h2"
      />
      <ContentContainer>
        <HowIWork />
      </ContentContainer>
    </div>
    <Backdrop
      background="var(--backdrop-gradient)"
      text="Contact me"
      headingLevel="h2"
    />
  </Layout>
</Html>
