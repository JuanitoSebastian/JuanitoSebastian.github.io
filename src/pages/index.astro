---
import Html from '../layouts/Html.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import AboutMe from '../components/home/AboutMe.astro';
import ContentContainer from '../components/home/ContentContainer.astro';
import HowIWork from '../components/home/HowIWork.astro';
import Backdrop from '../components/Backdrop.astro';
import ContactMe from '../components/home/ContactMe.astro';
import juanfiOgImage from '../images/juanfi-og-image.webp';
import WorkExperience from '../components/home/WorkExperience.astro';

const htmlProps = {
  title: 'Juan Sebastian Covarrubias',
  meta: {
    description:
      'Juan is a web developer and a former technical event production pro.',
    keywords: [
      'react',
      'javascript',
      'typescript',
      'software engineer',
      'web developer',
      'front-end developer',
      'full-stack developer',
    ],
    imageUrl: juanfiOgImage.src,
  },
};
---

<style lang="scss">
  .how-i-work-section,
  .work-experience-section {
    width: 100%;
  }

  h2 strong {
    transform: scaleX(1.3);
    display: inline-block;
    transform-origin: center;
    transform-box: fill-box;

    .how-i-work-section & {
      margin: 0 1rem;
    }

    .work-experience-section & {
      margin: 0 1.8rem;
    }
  }
</style>

<Html {...htmlProps}>
  <Layout>
    <Hero />
    <ContentContainer borderTop={true}>
      <AboutMe />
    </ContentContainer>
    <div class="how-i-work-section">
      <Backdrop background="var(--backdrop-gradient-1)">
        <h2 class="how-i-work-section-title">
          So, <strong>how</strong> do I do things?
        </h2>
      </Backdrop>
      <ContentContainer>
        <HowIWork />
      </ContentContainer>
    </div>
    <div class="work-experience-section">
      <Backdrop background="var(--backdrop-gradient-2)">
        <h2 class="work-experience-section-title">
          Here's <strong>where</strong> I've left my mark...
        </h2>
      </Backdrop>
      <ContentContainer>
        <WorkExperience />
      </ContentContainer>
    </div>
  </Layout>
  <ContactMe />
</Html>
