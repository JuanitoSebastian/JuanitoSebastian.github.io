---
import Html from '../layouts/Html.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import AboutMe from '../components/home/AboutMe.astro';
import ContentContainer from '../components/home/ContentContainer.astro';
import HowIWork from '../components/home/HowIWork.astro';
import Backdrop from '../components/Backdrop.astro';
import ContactMe from '../components/home/ContactMe.astro';
import juanitoImage from '../images/juanito_polaroid.webp';
import junitoOgImage from '../images/juanito_og_image.webp';

const htmlProps = {
  title: 'Juan Sebastian Covarrubias',
  meta: {
    description:
      'Juan is a web developer and a former technical event production pro.',
    keywords: [
      'react',
      'javascript',
      'typescript',
      'software engineer',
      'web developer',
      'front-end developer',
      'full-stack developer',
    ],
    imageUrl: junitoOgImage.src,
  },
  preload: [juanitoImage.src],
};
---

<style lang="scss">
  .how-i-work-section {
    width: 100%;
  }

  .how-i-work-section-title {
    strong {
      transform: scaleX(1.5);
      display: inline-block;
      transform-origin: center;
      transform-box: fill-box;
      margin: 0 calc(3rem / 2);
    }
  }
</style>

<Html {...htmlProps}>
  <Layout>
    <Hero />
    <ContentContainer borderTop={true}>
      <AboutMe />
    </ContentContainer>
    <div class="how-i-work-section">
      <Backdrop background="var(--backdrop-gradient)">
        <h2 class="how-i-work-section-title">
          So, <strong>how</strong> do I do things?
        </h2>
      </Backdrop>
      <ContentContainer>
        <HowIWork />
      </ContentContainer>
    </div>
    <ContactMe />
  </Layout>
</Html>
