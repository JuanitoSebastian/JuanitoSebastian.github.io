---
import { getCollection, render } from 'astro:content';

const aboutMeCollection = await getCollection('aboutMe');
const aboutMeEntry = aboutMeCollection[0];
const { Content } = await render(aboutMeEntry);
---

<style lang="scss">
  @import '../../styles/variables';

  .about-me {
    max-width: var(--main-width);
    display: flex;
    flex-direction: column;
    margin: 0 auto var(--spacing-lg);
    padding: 0 var(--spacing-md);
  }

  .title {
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 0.9;
    margin: var(--spacing-md) 0;
  }

  .about-me-content {
    max-width: 680px;
  }

  @media (min-width: #{$breakpoint-xsm}) {
    .title {
      font-size: 3.5rem;
    }
  }

  @media (min-width: #{$breakpoint-sm}) {
    .title {
      font-size: 4rem;
    }
  }
</style>

<article class="about-me">
  <section class="header">
    <h1 class="title">
      Juan<br />
      Sebastian<br />
      Covarrubias
    </h1>
  </section>
  <div class="about-me-content">
    <Content />
  </div>
</article>
