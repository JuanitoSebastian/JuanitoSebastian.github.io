---
import { Content } from '../../mds/AboutMe.md';
---

<style>
  .about-me {
    padding: var(--smaller-spacing) var(--default-spacing);
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(10px);
    max-width: var(--main-width);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, transparent 50%, var(--bg-color)),
      var(--bg-color) 100px
    );
  }

  .body {
    line-height: 1.6;
    font-size: 22px;
    color: var(--text-color);
  }

  .header {
  }

  .body p {
    margin: var(--bigger-spacing) 0;
  }

  .body strong {
    font-weight: 600;
    color: var(--accent-color);
  }

  .title {
    font-size: 58px;
    font-weight: 700;
    line-height: 0.9;
    margin: 0;
  }
</style>

<article class="about-me">
  <section class="header">
    <h1 class="title">
      Juan<br />
      Sebastian<br />
      Covarrubias
    </h1>
  </section>
  <div class="body">
    <Content />
  </div>
</article>
