---
import { Content } from '../../mds/AboutMe.md';
---

<style lang="scss">
  @import '../../styles/variables';

  .about-me {
    max-width: var(--main-width);
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 0.9;
    margin: 0;
  }

  @media (min-width: #{$breakpoint-sm}) {
    .title {
      font-size: 4rem;
    }
  }
</style>

<article class="about-me">
  <section class="header">
    <h1 class="title">
      Juan<br />
      Sebastian<br />
      Covarrubias
    </h1>
  </section>
  <Content />
</article>
