---
import { Image } from 'astro:assets';
import bgSrc from '../../images/hero/juan_bg.webp';
import juanSrc from '../../images/hero/juan.webp';
import BlurryCircle from './BlurryCircle.astro';
---

<style lang="scss">
  @import '../../styles/variables';

  .hero {
    width: 100%;
    height: clamp(500px, 79.75vh, 638px);
    position: relative;
    margin: 0 0 calc(var(--xxl-spacing) * -1);
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: var(--main-width);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bg {
    position: relative;
    z-index: var(--z-index-hero-bg);
    filter: var(--img-filter);
  }

  .juan {
    position: absolute;
    top: 0;
    left: 0;
    z-index: var(--z-index-hero-juan);
    pointer-events: none;
  }

  @media (min-width: #{$breakpoint-sm}) {
    .hero {
      margin: var(--bigger-spacing) 0 calc(var(--xxl-spacing) * -1);
    }
  }
</style>

<section class="hero" id="hero">
  <div class="hero-content">
    <Image src={bgSrc} alt="" class="hero-image bg" />
    <Image src={juanSrc} alt="" class="hero-image juan" />
    <BlurryCircle
      size="medium"
      color="var(--blurry-circle-blue)"
      bottom="10px"
      left="-50px"
      opacity={1}
    />
    <BlurryCircle
      size="large"
      color="var(--blurry-circle-green)"
      bottom="50px"
      right="-100px"
      opacity={0.7}
    />
  </div>
</section>
