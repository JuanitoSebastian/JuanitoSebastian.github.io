---
import { Image } from 'astro:assets';
import bgSrc from '../../images/hero/juan_bg.webp';
import juanSrc from '../../images/hero/juan.webp';
import BlurryCircle from './BlurryCircle.astro';
---

<style>
  .hero {
    width: 100%;
    position: relative;
    margin: var(--xl-spacing) 0 calc(var(--xxl-spacing) * -1);
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: var(--main-width);
  }

  .hero-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .bg {
    position: relative;
    z-index: var(--z-index-hero-bg);
    filter: var(--img-filter);
  }

  .juan {
    position: absolute;
    top: 0;
    left: 0;
    z-index: var(--z-index-hero-juan);
    pointer-events: none;
  }
</style>

<section class="hero" id="hero">
  <div class="hero-content">
    <Image src={bgSrc} alt="" class="hero-image bg" />
    <Image src={juanSrc} alt="" class="hero-image juan" />
    <BlurryCircle
      size="medium"
      color="#DCE4ED"
      bottom="10px"
      left="-50px"
      opacity={1}
    />
  </div>
</section>
