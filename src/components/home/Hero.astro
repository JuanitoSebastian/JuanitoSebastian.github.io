---
import { Image } from 'astro:assets';
import img4121 from '../../images/JSC_6449.webp';

const descriptions = [
  'Web Developer',
  'Bachelor of Computer Science',
  'Former Technical Event Production Pro',
];
---

<style>
  .hero {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--bigger-spacing);
    margin: var(--xl-spacing) 0 calc(var(--xl-spacing) * -1);
  }

  .profile-image {
    max-width: 400px;
    width: auto;
    height: auto;
    object-fit: cover;
    z-index: 0;
    flex-shrink: 0;
  }

  .descriptions {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 350px;
  }

  .descriptions li {
    position: relative;
    padding-left: var(--bigger-spacing);
    margin-bottom: var(--smaller-spacing);
    font-size: 26px;
    font-style: italic;
    line-height: 1.6;
  }

  .descriptions li::before {
    content: '→';
    position: absolute;
    left: 0;
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      gap: var(--md-spacing);
    }

    .profile-image {
      max-width: 300px;
    }
  }
</style>

<section class="hero" id="hero">
  <Image src={img4121} alt="" class="profile-image" />
  <ul class="descriptions">
    {descriptions.map((description) => <li>{description}</li>)}
  </ul>
</section>
