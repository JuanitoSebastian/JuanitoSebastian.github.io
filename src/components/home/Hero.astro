---
import { Image } from 'astro:assets';
import juanImg from '../../images/hero/juan.webp';
import BlurryCircle from './BlurryCircle.astro';
import TitleTags from './TitleTags.astro';
---

<style lang="scss">
  @import '../../styles/variables';

  .hero {
    width: 100%;
    height: clamp(500px, 79.75vh, 638px);
    position: relative;
    margin-bottom: calc(var(--spacing-xxlg) * -1);
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: var(--main-width);
  }

  .hero-image {
    width: calc(100% + clamp(0px, calc((960px - 100vw) * 0.7), 300px));
    height: 100%;
    object-fit: cover;
    display: block;
    transform: translateX(clamp(-300px, calc((100vw - 960px) * 0.5), 0px));
    position: relative;
    z-index: var(--z-index-hero-bg);
  }

  .hero-content-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% + clamp(0px, calc((960px - 100vw) * 0.7), 300px));
    height: 100%;
    transform: translateX(clamp(-300px, calc((100vw - 960px) * 0.5), 0px));
    z-index: var(--z-index-hero-juan);
    mask: url('/imgs/juan_mask.webp') no-repeat center/cover;
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-mask: url('/imgs/juan_mask.webp') no-repeat center/cover;
    background: var(--hero-bg-color);
  }

  @media (min-width: #{$breakpoint-lg}) {
    .hero {
      margin-top: var(--spacing-lg);
    }
  }
</style>

<section class="hero" id="hero">
  <div class="hero-content">
    <Image
      src={juanImg}
      alt=""
      class="hero-image"
      width={960 * 2}
      height={638 * 2}
    />

    <div class="hero-content-overlay">
      <BlurryCircle
        size="medium"
        color="var(--blurry-circle-blue)"
        bottom="10px"
        left="-50px"
        opacity={1}
      />
      <BlurryCircle
        size="large"
        color="var(--blurry-circle-green)"
        bottom="50px"
        right="-100px"
        opacity={0.7}
      />
    </div>

    <TitleTags />
  </div>
</section>
