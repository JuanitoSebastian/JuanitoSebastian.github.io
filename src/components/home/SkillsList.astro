---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
const skills = await getCollection('skills');
---

<style lang="scss">
  @import '../../styles/variables';

  .skills-list {
    display: flex;
    flex-flow: row wrap;
    gap: var(--spacing-lg);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .skill-list-title {
    margin: 0 0 var(--spacing-md);
  }

  .skill-item {
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .skill-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .skill-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--primary-text-color);
    font-family: var(--merriweather);
    font-style: italic;
  }

  @media (min-width: #{$breakpoint-sm}) {
    .skill-title {
      font-size: 1.25rem;
    }
  }

  @media (min-width: #{$breakpoint-lg}) {
    .skill-title {
      font-size: 1.5rem;
    }

    .skill-icon {
      width: 40px;
      height: 40px;
    }
  }
</style>

<div class="skill-list-container">
  <h3 class="skill-list-title">Some of the tech I've worked with</h3>
  <ul class="skills-list">
    {
      skills.map((skill) => (
        <li class="skill-item">
          <Icon url={skill.data.iconUrl} class="skill-icon" />
          <p class="skill-title">{skill.data.title}</p>
        </li>
      ))
    }
  </ul>
</div>
