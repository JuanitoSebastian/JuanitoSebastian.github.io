---
import { getCollection } from 'astro:content';
import WorkExperienceArticle from './WorkExperienceArticle.astro';

let workExperience = await getCollection('workExperience');
workExperience = workExperience.sort((a, b) => a.data.index - b.data.index);
---

<style lang="scss">
  .work-experience {
    max-width: var(--main-width);
    padding: 0 var(--spacing-md);
    margin: var(--spacing-md) auto;
  }
</style>

<section class="work-experience">
  {
    workExperience.map((work) => (
      <WorkExperienceArticle workExperienceItem={work} />
    ))
  }
</section>
