---
import Icon from './Icon.astro';

const links = [
  {
    label: 'LinkedIn',
    url: 'https://www.linkedin.com/in/juanito-sebastian/',
    icon: '/linkedin_icon.svg',
  },
  {
    label: 'GitHub',
    url: 'https://github.com/JuanitoSebastian',
    icon: '/github_icon.svg',
  },
  {
    label: 'Bluesky',
    url: 'https://bsky.app/profile/juan.fi',
    icon: '/bsky_icon.svg',
  },
  {
    label: 'Instagram',
    url: 'https://www.instagram.com/juanito.wav',
    icon: '/instagram_icon.svg',
  },
];
---

<style lang="scss">
  @import '../styles/variables.scss';

  .navigation {
    max-width: var(--main-width);
    width: 100%;
    height: calc(var(--spacing-xlg) * 1.5);
  }

  .navigation-list {
    height: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--spacing-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .navigation-link {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1rem;
    color: var(--text-color);
    font-weight: 400;
    text-decoration: none;
    font-style: italic;
    text-transform: lowercase;
    padding: var(--spacing-sm);
  }
</style>

<nav class="navigation">
  <ul class="navigation-list">
    {
      links.map((link) => (
        <li class="navigation-item">
          <a
            href={link.url}
            class="navigation-link"
            target="_blank"
            rel="noopener noreferrer">
            {link.label}
            <Icon url="/ext-link.svg" width={16} height={16} />
          </a>
        </li>
      ))
    }
  </ul>
</nav>
